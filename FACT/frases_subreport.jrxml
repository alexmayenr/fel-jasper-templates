	<variable name="FRASE" class="java.lang.String">
		<variableExpression><![CDATA[($F{tipo-frase}.equals("1") && $F{codigo-escenario}.equals("3")) ? $F{descripcion}.concat(" (" + $F{numero-resolucion} + " - " + new SimpleDateFormat("dd'/'MM'/'yyyy").format( new SimpleDateFormat("yyyy-MM-dd").parse($F{fecha-resolucion})) + ")") :
($F{tipo-frase}.equals("7") && ($F{codigo-escenario}.equals("1") || $F{codigo-escenario}.equals("2"))) ? $F{descripcion}.concat(", " + $F{numero-resolucion}) :
($F{tipo-frase}.equals("4") && $F{codigo-escenario}.equals("1")) ? "Exportaciones. ".concat($F{descripcion}) :
($F{tipo-frase}.equals("4") && $F{codigo-escenario}.equals("2")) ? "Servicios que presten las instituciones fiscalizadas por la SIB. ".concat($F{descripcion}) :
