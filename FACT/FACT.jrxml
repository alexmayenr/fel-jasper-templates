	</variable>
	<variable name="MontoGravableTotal" class="java.lang.String">
		<variableExpression><![CDATA[new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{MontoGravableTotal}))]]></variableExpression>
	</variable>
	<variable name="VENCIMIENTO" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{fecha-vencimiento}.substring(8,10)+ "/"+$F{fecha-vencimiento}.substring(5,7)+ "/"+$F{fecha-vencimiento}.substring(0,4)]]></variableExpression>
	</variable>
	<variable name="MesLetras2" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{fecha-emision}.substring(5,7).equals("01")? "En":
$F{fecha-emision}.substring(5,7).equals("02")? "Febr":
$F{fecha-emision}.substring(5,7).equals("03")? "Mzo":
$F{fecha-emision}.substring(5,7).equals("04")? "Abr":
$F{fecha-emision}.substring(5,7).equals("05")? "My":
$F{fecha-emision}.substring(5,7).equals("06")? "Jun":
$F{fecha-emision}.substring(5,7).equals("07")? "Jul":
$F{fecha-emision}.substring(5,7).equals("08")? "Ag":
$F{fecha-emision}.substring(5,7).equals("09")? "Sept":
$F{fecha-emision}.substring(5,7).equals("10")? "Oct":
$F{fecha-emision}.substring(5,7).equals("11")? "Nov":
$F{fecha-emision}.substring(5,7).equals("12")? "Dic": "No-Especificado"]]></variableExpression>
	</variable>
	<variable name="fechaGuion" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{diaNumero}.replace("[","").replace("]","")+"-"+$V{MesLetras}.replace("[","").replace("]","")+"-"+$V{anioNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="MesLetrasIM" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{fecha-emision}.substring(5,7).equals("01")? "Enero":
$F{fecha-emision}.substring(5,7).equals("02")? "Febrero":
$F{fecha-emision}.substring(5,7).equals("03")? "Marzo":
$F{fecha-emision}.substring(5,7).equals("04")? "Abril":
$F{fecha-emision}.substring(5,7).equals("05")? "Mayo":
$F{fecha-emision}.substring(5,7).equals("06")? "Junio":
$F{fecha-emision}.substring(5,7).equals("07")? "Julio":
$F{fecha-emision}.substring(5,7).equals("08")? "Agosto":
$F{fecha-emision}.substring(5,7).equals("09")? "Septiembre":
$F{fecha-emision}.substring(5,7).equals("10")? "Octubre":
$F{fecha-emision}.substring(5,7).equals("11")? "Noviembre":
$F{fecha-emision}.substring(5,7).equals("12")? "Diciembre": "No-Especificado"]]></variableExpression>
