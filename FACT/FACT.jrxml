	<variable name="diaNumero" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[Arrays.asList($F{fecha-emision}.toString().split("-").size()>=2 ?  (  ($F{fecha-emision}.split("-")[2])).toString() : $F{fecha-emision})]]></variableExpression>
	</variable>
	<variable name="mesNumero" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[Arrays.asList($F{fecha-emision}.toString().split("-").size()>=2 ?  (  ($F{fecha-emision}.split("-")[1])).toString() : $F{fecha-emision})]]></variableExpression>
	</variable>
	<variable name="anioNumero" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[Arrays.asList($F{fecha-emision}.toString().split("-").size()>=2 ?  (  ($F{fecha-emision}.split("-")[0])).toString() : $F{fecha-emision})]]></variableExpression>
	</variable>
	<variable name="totalDetalle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{total}))]]></variableExpression>
	</variable>
	<variable name="descuentoDetalle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA["Q "+new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{descuento}))]]></variableExpression>
	</variable>
	<variable name="precioDetalle" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{precio}))]]></variableExpression>
	</variable>
	<variable name="totalCabecera" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{total-numeros}))]]></variableExpression>
	</variable>
	<variable name="fechaDiagonal" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{diaNumero}.replace("[","").replace("]","")+"/"+$V{mesNumero}.replace("[","").replace("]","")+"/"+$V{anioNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="tipoDeDocumento" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{tipo}.equals("FACT")? "Factura Electrónica":
$F{tipo}.equals("FCAM")? "Factura Cambiaria Electrónica":
$F{tipo}.equals("FCAD")? "Factura Electrónica Cambiaraia de Pequeño Contribuyente":
$F{tipo}.equals("FESP")? "Factura Especial Electrónica":
$F{tipo}.equals("RECI")? "Recibo Electrónico":
$F{tipo}.equals("RDON")? "Recibo Electrónico de Donaciones":
$F{tipo}.equals("NCRE")? "Nota Crédito Electrónica":
$F{tipo}.equals("FPEQ")? "Factura Electrónica Pequeño Contribuyente":
$F{tipo}.equals("NDEB")? "Nota Débito Electrónica":
$F{tipo}.equals("NABN")? "Nota Abono Electrónica": "No-Especificado"]]></variableExpression>
	</variable>
	<variable name="totalEnLetrasMayuscula" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{total-letras-round}.toUpperCase()]]></variableExpression>
	</variable>
	<variable name="fechaLetras" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new SimpleDateFormat("dd' de 'MMMMM' de 'yyyy").format( new SimpleDateFormat("dd/mm/yyyy").parse($V{fechaDiagonal}))]]></variableExpression>
	</variable>
	<variable name="mesLetras" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new SimpleDateFormat("MMMMM").format( new SimpleDateFormat("dd/mm/yyyy").parse($V{fechaDiagonal}))]]></variableExpression>
	</variable>
	<variable name="mesInicialMayuscula" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{mesLetras}.substring(0,1).toUpperCase() + $V{mesLetras}.substring(1)]]></variableExpression>
	</variable>
	<variable name="fechaLetrasInicialMayuscula" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{diaNumero}.replace("[","").replace("]","")+" de "+$V{mesInicialMayuscula}.replace("[","").replace("]","") + " de "+$V{anioNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="simboloMoneda" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{emisor-tipo-moneda}.equals("USD")? "\$": "Q"]]></variableExpression>
	</variable>
	<variable name="descuentoCabecera" class="java.lang.Double" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[Double.valueOf($F{descuento})]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="descuentoCabeceraFormato" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{simboloMoneda}+" "+new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($V{descuentoCabecera}))]]></variableExpression>
	</variable>
	<variable name="subTotalValorCabecera" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[Double.valueOf($V{descuentoCabecera})+Double.valueOf($F{total-numeros})]]></variableExpression>
	</variable>
	<variable name="subTotalValorCabeceraFormato" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{simboloMoneda}+" "+new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($V{subTotalValorCabecera}))]]></variableExpression>
	</variable>
	<variable name="diaFormato" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{diaNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="mesFormato" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{mesNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="anioFormato" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{anioNumero}.replace("[","").replace("]","")]]></variableExpression>
	</variable>
	<variable name="tipoMoneda" class="java.lang.String"/>
	<variable name="preciounitario" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[new java.text.DecimalFormat("##,###,##0.00").format(Double.valueOf($F{precio-unitario}))]]></variableExpression>
	</variable>
	<variable name="PARTE1" class="java.lang.String">
		<variableExpression><![CDATA[Arrays.asList($F{descripcion}.toString().split("\\|").size()>0 ? (($F{descripcion}.split("\\|") [0])).toString() : "")]]></variableExpression>
	</variable>
	<variable name="PARTE2" class="java.lang.String">
		<variableExpression><![CDATA[Arrays.asList($F{descripcion}.toString().split("\\|").size()>1 ? (($F{descripcion}.split("\\|") [1])).toString(): "")]]></variableExpression>
	</variable>
	<variable name="PARTE3" class="java.lang.String">
		<variableExpression><![CDATA[$F{descripcion}.split("\\|").size()>2? $F{descripcion}.split("\\|")[2]: ""]]></variableExpression>
	</variable>
	<variable name="MesLetras" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{fecha-emision}.substring(5,7).equals("01")? "ENERO":
$F{fecha-emision}.substring(5,7).equals("02")? "FEBRERO":
$F{fecha-emision}.substring(5,7).equals("03")? "MARZO":
$F{fecha-emision}.substring(5,7).equals("04")? "ABRIL":
$F{fecha-emision}.substring(5,7).equals("05")? "MAYO":
$F{fecha-emision}.substring(5,7).equals("06")? "JUNIO":
$F{fecha-emision}.substring(5,7).equals("07")? "JULIO":
$F{fecha-emision}.substring(5,7).equals("08")? "AGOSTO":
$F{fecha-emision}.substring(5,7).equals("09")? "SEPTIEMBRE":
$F{fecha-emision}.substring(5,7).equals("10")? "OCTUBRE":
$F{fecha-emision}.substring(5,7).equals("11")? "NOVIEMBRE":
$F{fecha-emision}.substring(5,7).equals("12")? "DICIEMBRE": "No-Especificado"]]></variableExpression>
	</variable>
	<variable name="SubTotalDesc" class="java.lang.String">
